{
  "version": 2,
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/api/verify",
      "methods": ["POST"],
      "dest": "/api/verify.js"
    },
    {
      "src": "/api/admin",
      "methods": ["GET", "POST", "DELETE", "PATCH"],
      "dest": "/api/admin.js"
    },
    {
      "src": "/api/version",
      "methods": ["GET", "POST"],
      "dest": "/api/version.js"
    },
    {
      "src": "/api/status",
      "methods": ["GET", "POST"],
      "dest": "/api/status.js"
    },
    {
      "src": "/api/discord-link",
      "methods": ["POST"],
      "dest": "/api/discord-link.js"
    },
    {
      "src": "/api/my-license",
      "methods": ["GET"],
      "dest": "/api/my-license.js"
    },
    {
      "src": "/api/expiring",
      "methods": ["GET"],
      "dest": "/api/expiring.js"
    }
  ]
}
